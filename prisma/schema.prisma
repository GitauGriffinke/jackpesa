generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BET
  WIN
  REFUND
  ADJUSTMENT
}

enum BetStatus {
  PENDING
  WON
  LOST
  REFUNDED
}

enum RoundStatus {
  OPEN
  SETTLED
}

// Every amount in this schema is an integer number of cents (KES x 100).
// Never store money as a float.
model User {
  id           String        @id @default(cuid())
  name         String
  phone        String        @unique
  passwordHash String
  balanceCents Int           @default(0)
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  bets         Bet[]
}

// The ledger. Every money movement writes exactly one row here.
model Transaction {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  type              TransactionType
  amountCents       Int
  balanceAfterCents Int
  refId             String?
  createdAt         DateTime        @default(now())

  @@index([userId, createdAt])
}

// One provably fair round of any game.
model Round {
  id             String      @id @default(cuid())
  game           String
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  nonce          Int
  outcome        Json?
  status         RoundStatus @default(OPEN)
  createdAt      DateTime    @default(now())
  bets           Bet[]
}

model Bet {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  roundId     String
  round       Round     @relation(fields: [roundId], references: [id])
  game        String
  amountCents Int
  payoutCents Int       @default(0)
  status      BetStatus @default(PENDING)
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([roundId])
}